# MONGODB_URI: Connection string for MongoDB Atlas database (targets dedicated "marvi_mart" database).
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/marvi_mart?retryWrites=true&w=majority
# If omitted or not connected, Marvi Mart automatically falls back to safe persistent in-memory storage.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/marvi_mart?retryWrites=true&w=majority"

# ADMIN_PASSWORD: Password required for the store administrator to log into /admin.
# Default if not provided: marvi@admin2026
ADMIN_PASSWORD="marvi@admin2026"

# ADMIN_TOKEN_SECRET: Secret key for signing/validating administrative session tokens.
ADMIN_TOKEN_SECRET="marvimart_super_secret_jwt_key_2026"

# GEMINI_API_KEY: Required for optional Gemini AI features if configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PhonePe Payment Gateway Integration (Server-side Only)
# Leave unconfigured to run in Cash on Delivery mode. When ready to activate PhonePe:
# PHONEPE_MERCHANT_ID: Your official PhonePe Merchant ID (e.g., M2306160483220055407824 or PGTESTPAYUAT for sandbox)
PHONEPE_MERCHANT_ID=""
# PHONEPE_SALT_KEY: Secret cryptographic salt key provided in your PhonePe merchant portal
PHONEPE_SALT_KEY=""
# PHONEPE_SALT_INDEX: Salt index / key index (typically "1")
PHONEPE_SALT_INDEX="1"
# PHONEPE_ENV: "UAT" for testing / sandbox or "PROD" for production transactions
PHONEPE_ENV="UAT"

